{
  "expo": {
    "name": "Hindi Bible",
    "slug": "hindi-bible",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "package": "com.igurpeetsingh.hindibible",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/hindi-bible-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "icon": "./assets/hindi-bible-icon.png",
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    }
  }
}
